# Shopify Store Credentials
# Your store domain, e.g. "my-gadget-store.myshopify.com"
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify Admin API Access Token (Starts with "shpat_")
# Generated in Shopify Admin -> Settings -> Apps and sales channels -> Develop apps
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shopify API Version (e.g. 2024-10)
SHOPIFY_API_VERSION=2024-10

# Google Gemini API Key (for AI product copy & optimization)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Profit Margin Multiplier (e.g. 2.5 means $10 cost -> $24.99 price)
DEFAULT_PRICE_MULTIPLIER=2.5

